# Endpoint da API de previsão. Opcional: o padrão é a API pública do Open-Meteo.
# Útil para apontar para uma instância própria (self-hosted) ou um mock em testes.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Endpoint da busca de cidades. Opcional: o padrão é a API pública de geocodificação do Open-Meteo.
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Arquivo histórico usado para as médias de temperatura. Opcional.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
